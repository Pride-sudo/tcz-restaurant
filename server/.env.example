# ---- Core ----
NODE_ENV=development
PORT=5000
# Local:  mongodb://127.0.0.1:27017/tcz   |  Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/tcz
MONGODB_URI=mongodb://127.0.0.1:27017/tcz
# Generate: openssl rand -hex 48   (min 32 chars)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
# Set true in production (HTTPS). Use COOKIE_SAMESITE=none only if client and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Payments ----
# Stripe (test mode keys start with sk_test_). Leave blank to disable card payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development-only fake payment option (never works when NODE_ENV=production)
DEV_PAYMENTS_ENABLED=true

# ---- Email (optional; without SMTP, reset links are printed to the server log in development) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TCZ Restaurant <no-reply@example.com>"

# ---- Uploads ----
UPLOAD_DIR=uploads

# ---- Initial administrator (used by `npm run create-admin`) ----
ADMIN_NAME=Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=
